# =============================================================================
# 部署环境变量模板（S29.1）—— 复制为 .env 后填写，.env 不入库、权限 600
#
#   cp .env.example .env && chmod 600 .env
#
# 该文件同时被 deploy.sh（source）与 docker compose（插值）读取，
# 所以：只用「KEY=value」与整行注释，不要写行内注释；
# 含空格或 ? 的值必须加引号（JAVA_OPTS 用双引号，URL 带 query 用单引号）。
# =============================================================================

# ---------- 版本与目标 ----------
# 本地演示构建填 local（配合 compose.build.yml）；流水线发版填 vX.Y.Z
RELEASE_VERSION=local
# wsl | cloud —— 决定加载哪份 target 覆盖文件
TARGET=wsl

# ---------- 数据与备份（必须绝对路径）----------
# 不要放在 /mnt/c（9p 文件系统会让 MySQL 抖动）；默认放家目录，避免日常备份要 sudo
DATA_DIR=/home/user01/sdblog/data
BACKUP_DIR=/home/user01/sdblog/backups
# 备份保留份数（本地轮转，超出即删最旧）
KEEP_BACKUPS=7

# ---------- 宿主机端口（容器内端口永不变；演示段 19xxx）----------
BACKEND_PORT=19081
ADMIN_PORT=19080
WEB_PORT=19300
MYSQL_PORT=13306
REDIS_PORT=16379
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
ES_PORT=19200

# ---------- 演示种子（一次性服务，不随 up 启动）----------
# seed-min.sql：8 篇，开发/冒烟够用；seed-demo.sql：52 篇，演示/面试用
SEED_FILE=seed-demo.sql

# ---------- 凭据（首次启动前必须改，且不得与开发环境相同）----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ry-vue
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---------- 资源上限（WSL 内存紧张；容器内堆必须明显小于内存上限）----------
JAVA_OPTS="-Xms256m -Xmx512m"
BACKEND_MEM=1g
ES_JAVA_OPTS="-Xms256m -Xmx256m"
ES_MEM=900m
MYSQL_MEM=800m
REDIS_MEM=128m
MINIO_MEM=256m
WEB_MEM=512m
ADMIN_MEM=128m

# ---------- 公网入口 ----------
PUBLIC_SITE_URL='https://sdblog.us.ci'
ADMIN_PUBLIC_URL='https://admin.sdblog.us.ci'

# ---------- 前台登录链路（必须与 sys_client / 后端 api-decrypt 配置一致）----------
# web 客户端 client_id 见 docs/blog_s9_web_client.sql 的验证段
NUXT_APP_CLIENT_ID=
NUXT_RSA_PUBLIC_KEY=
NUXT_RSA_PRIVATE_KEY=

# ---------- 社交登录（S14；prod justauth 已改为读取这些变量）----------
JUSTAUTH_ADDRESS='https://sdblog.us.ci'
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI='https://sdblog.us.ci/social-callback?source=github'
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
GITEE_REDIRECT_URI='https://sdblog.us.ci/social-callback?source=gitee'

IMG_PUBLIC_URL='https://img.sdblog.us.ci'

# MinIO 桶名（RuoYi OSS 配置用；domain_url 会拼成 https://img.../<桶名>）
MINIO_BUCKET=ruoyi
