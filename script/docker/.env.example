# =============================================================================
# Stack Depth 博客 · compose 环境变量
#
# 用法：cp .env.example .env，按需修改后 `docker compose up -d`
# .env 已被 .gitignore / .dockerignore 排除，密钥不会进仓库也不会进镜像。
# =============================================================================

# 镜像 tag：同一次发版三个镜像共用一个 tag，便于整体回滚
TAG=latest

# ---------- 宿主机端口映射 ----------
# 端口被占用时改这里即可，容器内端口固定不变
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8081
WEB_PORT=3000
ADMIN_PORT=8080

# ---------- 中间件凭据 ----------
# ⚠️ 首次启动前改掉这三个；数据卷一旦初始化，改密码需要进库同步修改
MYSQL_ROOT_PASSWORD=root
REDIS_PASSWORD=ruoyi123
MINIO_ROOT_USER=ruoyi
MINIO_ROOT_PASSWORD=ruoyi123

# ---------- 后端 ----------
# 堆大小：整套（ES 512m + MySQL + 后端 + 两个前端）约需 3~4GB 内存
JAVA_OPTS=-Xms512m -Xmx1024m

# ---------- 应用密钥（必填：首次启动前生成）----------
# 仓库内不保留任何默认密钥；缺失时后端启动直接失败（不会静默回落）。
# 生成：./gen-secrets.sh（写入本文件，并把前端需要的两个值一并填好）
JWT_SECRET_KEY=
# 接口加密密钥对：私钥解密请求、公钥加密响应
API_DECRYPT_PRIVATE_KEY=
API_DECRYPT_PUBLIC_KEY=

# ---------- 前台（blog-web）与管理后台镜像 ----------
# client_id 来自数据库 sys_client（建库脚本 blog_s9_web_client.sql 的验证段可查）
NUXT_APP_CLIENT_ID=
# 下面两个由 gen-secrets.sh 自动填写，是后端密钥对的「前端那一半」，不可自行改写：
#   NUXT_RSA_PUBLIC_KEY  ↔ API_DECRYPT_PRIVATE_KEY（请求加密公钥）
#   NUXT_RSA_PRIVATE_KEY ↔ API_DECRYPT_PUBLIC_KEY（响应解密私钥）
# 读者站运行时读取；管理后台在**镜像构建期**内联，换值必须重建后台镜像。
NUXT_RSA_PUBLIC_KEY=
NUXT_RSA_PRIVATE_KEY=

# SEO 绝对地址（sitemap / rss / robots 用它拼全站链接），生产改成真实域名
PUBLIC_SITE_URL=http://localhost:3000

# ---------- 演示数据（一次性服务，不影响 up -d）----------
# seed-min.sql ：开发用，3 作者 / 8 篇 / 30 评论，覆盖全部状态与版式分支
# seed-demo.sql：演示/面试用，5 作者 / 52 篇 / 200 评论
# 装载：docker compose --profile seed run --rm seed
SEED_FILE=seed-min.sql
