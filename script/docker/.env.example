# =============================================================================
# Stack Depth 博客 · compose 环境变量
#
# 用法：cp .env.example .env，按需修改后 `docker compose up -d`
# .env 已被 .gitignore / .dockerignore 排除，密钥不会进仓库也不会进镜像。
# =============================================================================

# 镜像 tag：同一次发版三个镜像共用一个 tag，便于整体回滚
TAG=latest

# ---------- 宿主机端口映射 ----------
# 端口被占用时改这里即可，容器内端口固定不变
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8081
WEB_PORT=3000
ADMIN_PORT=8080

# ---------- 中间件凭据 ----------
# ⚠️ 首次启动前改掉这三个；数据卷一旦初始化，改密码需要进库同步修改
MYSQL_ROOT_PASSWORD=root
REDIS_PASSWORD=ruoyi123
MINIO_ROOT_USER=ruoyi
MINIO_ROOT_PASSWORD=ruoyi123

# ---------- 后端 ----------
# 堆大小：整套（ES 512m + MySQL + 后端 + 两个前端）约需 3~4GB 内存
JAVA_OPTS=-Xms512m -Xmx1024m

# ---------- 前台（blog-web）----------
# 这三个是登录链路必需的：client_id 与 RSA 公私钥必须与数据库 sys_client / 后端配置一致
# 取值见 blog-web/.env
NUXT_APP_CLIENT_ID=
NUXT_RSA_PUBLIC_KEY=
NUXT_RSA_PRIVATE_KEY=

# SEO 绝对地址（sitemap / rss / robots 用它拼全站链接），生产改成真实域名
PUBLIC_SITE_URL=http://localhost:3000
