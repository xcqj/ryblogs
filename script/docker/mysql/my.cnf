# =============================================================================
# MySQL 启动配置（S25）
#
# 为什么需要这个文件：
#   Docker 官方 mysql 镜像的 initdb 用 `mysql` 客户端执行 /docker-entrypoint-initdb.d/*.sql，
#   而该客户端在未显式指定字符集时默认 **latin1**。于是 ry_vue.sql 里的 UTF-8 中文被当成
#   latin1 逐字节拆开——`'本部门及以下 密码666666'` 从 15 字符膨胀成 31+ 字符，
#   直接顶爆 `sys_user.nick_name varchar(30)`：
#       ERROR 1406 (22001) at line 113: Data too long for column 'nick_name' at row 1
#   initdb 一旦报错，entrypoint 会中止并停容器，表现为「一键启动后数据库是空的」。
#
#   [mysqld] 段决定服务端默认字符集；[client] 段让 initdb 用的 mysql 客户端也用 utf8mb4，
#   两个都要有，缺 [client] 则问题依旧。
#
#   注：MySQL 8.4 已移除 `character-set-client-handshake` 变量（传了会 unknown variable 启动失败），
#   所以只能从客户端配置侧解决。
# =============================================================================

[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci
# 表名大小写不敏感：必须在首次初始化时生效，中途修改会导致 MySQL 拒绝启动
lower_case_table_names = 1

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
